{
  "mqtt": {
    "brokerUrl": "mqtt://homeassistant.local:1883",
    "username": "",
    "password": ""
  },
  "evCharging": {
    "mode": "charge",
    "targetKwh": 7,
    "targetTime": "12:00",
    "chargeNowHours": 2,
    "mqtt": {
      "powerTopic": "zigbee2mqtt/ev-relay",
      "powerField": "power",
      "powerThresholdW": 10,
      "energyField": "energy",
      "chargerTopic": "zigbee2mqtt/ev-relay/set",
      "onPayload": "{\"state\":\"ON\"}",
      "offPayload": "{\"state\":\"OFF\"}"
    }
  },
  "solar": {
    "lat": 61.5,
    "lon": 24.7,
    "declination": 35,
    "azimuth": 0,
    "kwp": 7.5,
    "treeShadingSchedule": [
      { "time": "13:00", "outputFraction": 1.0 },
      { "time": "14:30", "outputFraction": 0.5 },
      { "time": "16:30", "outputFraction": 0.1 }
    ],
    "influx": {
      "measurement": "power-forecast",
      "tags": {
        "device": "solar",
        "unit": "W"
      }
    }
  },
  "electricity": {
    "transportCostEurKwh": 0.045,
    "influx": {
      "measurement": "electricity-cost-forecast",
      "tags": {
        "unit": "Eur/kWh"
      }
    }
  },
  "influx": {
    "url": "http://localhost:8086",
    "token": "",
    "org": "",
    "bucket": "default",
    "tags": {
      "location": "garage",
      "charger_type": "ICU Compact Mini"
    }
  },
  "setpointControl": {
    "waterHeating": {
      "name": "Water Heater",
      "setpointDefault": 51,
      "setpointCheap": 60,
      "setpointExpensive": 45,
      "expensiveFactor": 1.5,
      "defaultPowerConsumptionW": 2000,
      "mqtt": {
        "commandTopic": "zigbee2mqtt/water-heater/set"
      }
    }
  },
  "mqttToInflux": {
    "sensors": [
      {
        "name": "autotalli_motion",
        "type": "motion",
        "device": "autotalli",
        "location": "autotalli",
        "mqtt_topic": "sensors/autotalli/motion",
        "unit": ""
      },
      {
        "name": "Autotallin liiketunnistin",
        "type": "motion",
        "device": "Zigbee PIR sensor",
        "location": "autotalli",
        "mqtt_topic": "zigbee2mqtt/Autotallin liiketunnistin",
        "unit": "",
        "json_field": "occupancy"
      },
      {
        "name": "Radiator Return",
        "type": "temperature",
        "device": "heatpump",
        "location": "patterit-paluu",
        "mqtt_topic": "b0cbd8f1c4a4/HP/0001",
        "unit": "°C"
      },
      {
        "name": "raimo-unit-6_temperature",
        "type": "temperature",
        "device": "raimo-unit-6",
        "location": "terassi",
        "mqtt_topic": "sensors/raimo-unit-6/temperature",
        "unit": "°C"
      },
      {
        "name": "raimo_unit_wc_temperature",
        "type": "temperature",
        "device": "raimo_unit_wc",
        "location": "wc",
        "mqtt_topic": "sensors/raimo_unit_wc/temperature",
        "unit": "°C"
      }
    ]
  }
}
