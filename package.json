{
  "type": "module",
  "scripts": {
    "typecheck": "tsc",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node12 --outfile=dist/bundle.cjs --inject:src/utils/polyfill.ts",
    "test": "TZ=Europe/Helsinki node --strip-types --test --test-concurrency=1 test/planner.test.ts test/setpoint-control.test.ts test/mqtt-client.test.ts test/mqtt-to-influx.test.ts test/plan-store.test.ts",
    "test:integration": "TZ=Europe/Helsinki node --strip-types --test test/main-loop-mqtt.test.ts test/influx.test.ts test/forecast-influx.test.ts",
    "lint": "eslint src/ test/ --max-warnings=0",
    "format": "prettier --write src/ test/"
  },
  "dependencies": {
    "mqtt": "^4.3.8",
    "node-fetch": "^2.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node-fetch": "^2.6.13",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
